# Federated Learning Server
FL_SERVER_ADDRESS=127.0.0.1:8080
FL_ROUNDS=5
FL_MIN_CLIENTS=3

# Inference API
API_HOST=0.0.0.0
API_PORT=5000

# Privacy (differential privacy per client)
PRIVACY_EPSILON=3.0
PRIVACY_DELTA=1e-5
PRIVACY_NOISE_MULTIPLIER=1.0
PRIVACY_MAX_GRAD_NORM=1.0

# Training
LOCAL_EPOCHS=5
CENTRALIZED_EPOCHS=20
LEARNING_RATE=0.001
